.nuxt/
.output/
.data/
dist/

# Node modules (reinstalled in Docker)
node_modules/

# Storybook (not part of the shipped site)
.storybook/
storybook-static/

# Env files
.env
.env.*
!.env.example

# Logs
*.log
logs/

